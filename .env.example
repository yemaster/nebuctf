# Generate each secret independently: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_SECRET=
# One app image runs API, Scheduler, Runtime (worker), and gateway.
# Scheduler needs PostgreSQL only; Docker socket access belongs to Runtime alone.
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
CHALLENGE_HOST=localhost
CHALLENGE_BIND=127.0.0.1
# Empty uses Docker's default allocation; set a range for firewall allowlists.
CHALLENGE_PORT_RANGE=
IMAGE_PREFIXES=nebuctf/
MAX_INSTANCES=64
MAX_OWNER_INSTANCES=2
MAX_CPU=16000
MAX_MEMORY=16384
# Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
DOCKER_SOCKET=/var/run/docker.sock

# Domain mode: *.labs.example.net points to the TLS reverse proxy.
CHALLENGE_DOMAIN=labs.localhost
DOMAIN_SCHEME=https
GATEWAY_HTTP_PORT=8081

# 个人终端镜像，先用 deploy/terminal/Dockerfile 构建
TERMINAL_IMAGE=nebuctf/terminal:local

# 可选流量采集镜像；启用抓包前构建 deploy/traffic/Dockerfile
TRAFFIC_IMAGE=nebuctf/traffic:local

# Hybrid k3s uses deploy/runtime-compose.yaml with a separate, root-readable env
# file. DATABASE_URL must use 10.43.0.20:5432 and the non-admin nebuctf role.
# See docs/DEPLOYMENT.md for local image tags, role Secrets, and fixed host paths.
