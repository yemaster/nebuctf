# Generate each secret independently: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_SECRET=
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
CHALLENGE_HOST=localhost
CHALLENGE_BIND=127.0.0.1
IMAGE_PREFIXES=nebuctf/
MAX_INSTANCES=64
MAX_OWNER_INSTANCES=2
MAX_CPU=16000
MAX_MEMORY=16384
# Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
DOCKER_SOCKET=/var/run/docker.sock

# Domain mode: *.labs.example.net points to the TLS reverse proxy.
CHALLENGE_DOMAIN=labs.localhost
DOMAIN_SCHEME=https
GATEWAY_HTTP_PORT=8081
