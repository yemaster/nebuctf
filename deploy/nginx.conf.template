map $http_upgrade $connection_upgrade { default upgrade; '' close; }
geo $realip_remote_addr $trusted_ingress {
  default 0;
  ${NGINX_TRUSTED_PROXY_CIDR} 1;
}
map "$trusted_ingress:$http_x_forwarded_proto" $forwarded_proto {
  default $scheme;
  "1:http" http;
  "1:https" https;
}
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  set_real_ip_from ${NGINX_TRUSTED_PROXY_CIDR};
  real_ip_header X-Forwarded-For;
  real_ip_recursive on;
  server_tokens off;
  gzip_static on;
  gzip_vary on;
  gzip on;
  gzip_comp_level 3;
  gzip_min_length 1024;
  gzip_types application/json application/javascript text/css image/svg+xml application/wasm;
  gzip_proxied any;
  resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
  resolver_timeout 2s;
  client_max_body_size 21m;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy same-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  location ^~ /api/ai/ {
    gzip off;
    limit_req zone=api burst=60 nodelay;
    client_max_body_size 1m;
    set $api_upstream ${NGINX_API_UPSTREAM};
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_connect_timeout 5s;
    proxy_read_timeout 310s;
    proxy_send_timeout 30s;
    proxy_buffering off;
  }
  location ~ ^/api/admin/(contests|challenges)/[0-9a-f-]+/export$ {
    limit_req zone=api burst=5 nodelay;
    set $api_upstream ${NGINX_API_UPSTREAM};
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_buffering off;
  }
  location = /_transfer_access {
    internal;
    # Auth subrequests inherit the upload Content-Length, even without its body.
    client_max_body_size 257m;
    set $api_upstream ${NGINX_API_UPSTREAM};
    proxy_pass http://$api_upstream/api/admin/transfers/access;
    proxy_pass_request_body off;
    proxy_method GET;
    proxy_set_header Content-Length "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
  }
  location = /api/admin/transfers/preview {
    auth_request /_transfer_access;
    client_body_temp_path /var/cache/nebuctf/uploads;
    limit_req zone=api burst=5 nodelay;
    client_max_body_size 257m;
    set $api_upstream ${NGINX_API_UPSTREAM};
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_connect_timeout 5s;
    proxy_read_timeout 120s;
    proxy_request_buffering on;
  }
  location /api/ {
    limit_req zone=api burst=60 nodelay;
    set $api_upstream ${NGINX_API_UPSTREAM};
    proxy_pass http://$api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    proxy_connect_timeout 5s;
    proxy_read_timeout 75s;
    proxy_request_buffering on;
  }
  location /assets/ { try_files $uri @asset_archive; expires 1y; }
  location @asset_archive {
    root /var/cache/nebuctf;
    include /etc/nginx/mime.types;
    types { application/javascript mjs; }
    try_files $uri =404;
    expires 1y;
  }
  location /pdfjs/ { try_files $uri @asset_archive; expires 1y; }
  location ~ ^/assets/[^/]+\.mjs$ {
    types { application/javascript mjs; }
    try_files $uri @asset_archive;
    expires 1y;
  }
  location / { expires -1; try_files $uri $uri/ /index.html; }
}
