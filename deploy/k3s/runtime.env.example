# Copy OUTSIDE the repo to /root/nebuctf-runtime.env; chmod 600.
# Blank required secrets are intentionally not runnable until supplied.
NEBUCTF_RELEASE=local
# The URL must contain a URL-encoded nebuctf role password, never postgres admin.
# Host is the fixed Service IP 10.43.0.20, port 5432, database nebuctf.
DATABASE_URL=
APP_SECRET=
# Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=
DOCKER_SOCKET=/var/run/docker.sock
APP_ORIGIN=http://101.34.76.52:61001
COOKIE_SECURE=false
CHALLENGE_HOST=101.34.76.52
CHALLENGE_BIND=0.0.0.0
CHALLENGE_PORT_RANGE=30000-50000
CHALLENGE_DOMAIN=labs.localhost
DOMAIN_SCHEME=http
IMAGE_PREFIXES=nebuctf/
TERMINAL_IMAGE=nebuctf/terminal:local
TRAFFIC_IMAGE=nebuctf/traffic:local
GATEWAY_HTTP_PORT=8081
MAX_INSTANCES=2
MAX_OWNER_INSTANCES=2
MAX_CPU=1000
MAX_MEMORY=512
